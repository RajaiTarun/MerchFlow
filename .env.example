# Copy this file to .env at the repo root and fill in real values.
# All 5 backend services load this same root-level .env (see each
# service's `require('dotenv').config({ path: '../../.env' })`).

# Postgres — used by user-service and order-service (Neon/Supabase both work; needs sslmode=require)
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# MongoDB — used by catalog-service (MongoDB Atlas or any Mongo instance)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/dbname

# Valkey / Redis-compatible instance — used for catalog caching, distributed
# locking, idempotency keys, and gateway rate limiting (Upstash or self-hosted)
VALKEY_URL=redis://default:password@host:6379

# RabbitMQ — used for order/delivery event delivery to notification-service (CloudAMQP or self-hosted)
RABBITMQ_URL=amqps://user:password@host/vhost

# Secret used to sign/verify JWTs issued at login
JWT_SECRET=replace-with-a-long-random-string

# Shared secret every internal service-to-service call must present
# (see internalAuthMiddleware in each service's index.js)
INTERNAL_SERVICE_KEY=replace-with-a-long-random-string

# --- Ports ---
PORT=3000                          # API Gateway (the only one meant to be public-facing)
USER_SERVICE_PORT=3001
CATALOG_SERVICE_PORT=3002
ORDER_SERVICE_PORT=3003
NOTIFICATION_SERVICE_PORT=3004
